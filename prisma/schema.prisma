generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OnlineContestSubmission {
  id        String   @id @default(cuid())
  teamName  String   @unique
  email     String   @unique
  url       String   @unique
  ipAddress String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // incase team updates submission
}

model Team {
  id               String   @id @default(cuid())
  name             String
  leaderEmail      String
  leaderName       String
  labNumber        String @default("NOT_ASSIGNED")
  presentationSlot String @default("NOT_ASSIGNED")
  status           Status   @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum Status {
  PENDING
  SHORTLISTED
  REJECTED
}
